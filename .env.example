# Notion CRM Integration
# Create a Notion integration at https://www.notion.so/my-integrations
# Share all 3 databases with the integration
NOTION_API_KEY=ntn_your_notion_integration_token

# Notion database IDs (created via Notion MCP under "SUKL MCP — CRM" page)
NOTION_DB_LEADS=1c851a6a887d49198b4bdd29275b8ac2
NOTION_DB_ENTERPRISE=edc64118b1424db48d33a2ebafb41b2f
NOTION_DB_NEWSLETTER=2e03cd2171b94ce6a1d0e3e97093daa0

# Resend Email Integration (optional — forms work without this)
# Create API key at https://resend.com/api-keys
# Verify sender domain at https://resend.com/domains
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_OWNER_EMAIL=your@email.com

# Public ChatGPT plugin (no OAuth or OpenAI API key is needed)
MCP_PUBLIC_ORIGIN=https://sukl-mcp.vercel.app
MCP_WIDGET_DOMAIN=https://sukl-mcp.vercel.app
# Exact additional browser origins only, comma-separated. No wildcard.
MCP_ALLOWED_ORIGINS=

# Confirm real settings before enabling the legal pages (drafts return 503 otherwise)
PUBLICATION_POLICY_CONFIRMED=false
# Describe runtime log availability separately from provider security/hosting retention.
PRIVACY_HOST_LOG_RETENTION=
# Required only when legacy forms are enabled.
PRIVACY_FORM_RETENTION=
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Legacy web forms are separate from the public plugin and disabled by default in production.
LEGACY_FORMS_ENABLED=false
# A shared Redis REST lease is required before enabling newsletter signup.
NEWSLETTER_REDIS_REST_URL=
NEWSLETTER_REDIS_REST_TOKEN=

# Build the submission package for your verified public origin.
PLUGIN_BASE_URL=https://sukl-mcp.vercel.app
# Supply the real reviewer-accessible demo video URL when recorded.
PLUGIN_DEMO_URL=

# Enable only after configuring and testing the shared protection.
PUBLIC_LAUNCH_MODE=false
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
# Vercel Upstash integration injects these automatically. A complete custom pair above overrides them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cryptographically random private salt, at least 32 characters. Never package this value.
RATE_LIMIT_HASH_SECRET=
PRIVACY_REDIS_PROVIDER=

# Exact public domain-verification token issued by the OpenAI submission portal.
# Leave empty until issued; the challenge URL returns 404 instead of a placeholder.
OPENAI_APPS_CHALLENGE=
